    {"tipo": "palavra", "itens": [[":root", ":root", "Raiz do documento (variáveis globais)."], [":hover", ":hover", "Mouse em cima."], [":focus-visible", ":focus-visible", "Foco por teclado."], [":is", ":is(a, b)", "Qualquer um dos seletores.", ":is(${0})"],
     [":where", ":where(a, b)", "Como :is, sem especificidade.", ":where(${0})"], [":has", ":has(seletor)", "Pai que contém.", ":has(${0})"], ["::before", "::before", "Pseudo-elemento antes."], ["::after", "::after", "Pseudo-elemento depois."],
     [":not", ":not(seletor)", "Negação.", ":not(${0})"], [":nth-child", ":nth-child(n)", "Pela posição.", ":nth-child(${2n})${0}"]]}
