  {"id": "css.regras", "linguagem": "css", "rotulo": "Regras @", "descricao": "@media, @keyframes, @container, @layer, @supports. Aparecem depois de '@'.",
   "grupos": [
    {"tipo": "arroba", "itens": [
     ["media", "@media (max-width: ...)", "Estilos por tamanho de tela.", "media (max-width: ${760px}) {\n  ${0}\n}"],
     ["media-reduce", "@media (prefers-reduced-motion: reduce)", "Respeita quem pediu menos movimento.", "media (prefers-reduced-motion: reduce) {\n  *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }\n}${0}"],
     ["media-dark", "@media (prefers-color-scheme: dark)", "Tema escuro do sistema.", "media (prefers-color-scheme: dark) {\n  :root { ${0} }\n}"],
     ["keyframes", "@keyframes nome", "Passos de uma animação.", "keyframes ${nome} {\n  from { ${opacity: 0; transform: translateY(4px);} }\n  to { ${opacity: 1; transform: none;} }\n}${0}"],
     ["container", "@container (min-width: ...)", "Estilos pelo tamanho do contêiner.", "container (min-width: ${30rem}) {\n  ${0}\n}"],
     ["supports", "@supports (prop: valor)", "Só se o navegador suportar.", "supports (${display: grid}) {\n  ${0}\n}"],
     ["layer", "@layer nome", "Camadas de cascata.", "layer ${base} {\n  ${0}\n}"],
     ["font-face", "@font-face", "Fonte própria.", "font-face {\n  font-family: \"${Nome}\";\n  src: url(\"${fonte.woff2}\") format(\"woff2\");\n  font-display: swap;\n}${0}"],
     ["import", "@import url()", "Importa outro CSS.", "import url(\"${arquivo.css}\");${0}"]]}
   ]},
  {"id": "css.trechos", "linguagem": "css", "rotulo": "Padrões prontos", "descricao": "Centralizar, grade responsiva, foco visível, texto só para leitor de tela, variáveis de tema, transições.",
   "grupos": [
    {"tipo": "trecho", "itens": [
     ["centro", "centralizar", "Centraliza o conteúdo nos dois eixos.", "display: grid;\nplace-items: center;${0}"],
     ["gradeauto", "grade responsiva", "Cartões que se ajustam à largura.", "display: grid;\ngrid-template-columns: repeat(auto-fill, minmax(${16rem}, 1fr));\ngap: ${1rem};${0}"],
     ["foco", ":focus-visible", "Foco visível só para teclado.", ":focus-visible {\n  outline: 2px solid ${var(--foco)};\n  outline-offset: 2px;\n}${0}"],
     ["srOnly", ".sr-only", "Texto só para leitor de tela.", ".sr-only {\n  position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;\n  overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;\n}${0}"],
     ["tema", ":root com variáveis", "Paleta em variáveis.", ":root {\n  --fundo: ${#ffffff};\n  --texto: ${#1a1a1a};\n  --primaria: ${#005a9c};\n  --foco: ${#ffbf47};\n}${0}"],
     ["hover", ":hover com transição", "Resposta ao passar o mouse.", "transition: background-color 150ms ease-out, transform 150ms ease-out;\n\n&:hover {\n  background-color: ${var(--realce)};\n  transform: translateY(-1px);\n}${0}"],
     ["entrada", "animação de entrada", "Aparece suave (respeite prefers-reduced-motion).", "animation: entrar 180ms ease-out both;\n\n@keyframes entrar {\n  from { opacity: 0; transform: translateY(4px); }\n}${0}"],
     ["reticencias", "texto com …", "Corta texto longo numa linha.", "overflow: hidden;\ntext-overflow: ellipsis;\nwhite-space: nowrap;\nmin-width: 0;${0}"],
