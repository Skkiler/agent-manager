     ["dataclass", "@dataclass", "Classe de dados (gera __init__, __repr__ e __eq__).", "from dataclasses import dataclass, field\n\n\n@dataclass\nclass ${Nome}:\n    ${campo}: ${str}\n    ${0}"],
     ["main", "if __name__ == '__main__'", "Ponto de entrada do script.", "def main() -> None:\n    ${0}\n\n\nif __name__ == \"__main__\":\n    main()"],
     ["with", "with open(...)", "Abre arquivo e fecha sozinho.", "with open(${arquivo}, encoding=\"utf-8\") as f:\n    ${0}"],
     ["try", "try/except", "Tratamento de erro específico.", "try:\n    ${0}\nexcept ${ValueError} as e:\n    raise"],
     ["tryf", "try/except/finally", "Erro + limpeza garantida.", "try:\n    ${0}\nexcept ${Exception} as e:\n    log.exception(\"falhou: %s\", e)\nfinally:\n    ${pass}"],
     ["for", "for ... in", "Laço.", "for ${item} in ${itens}:\n    ${0}"],
     ["fore", "for i, x in enumerate", "Laço com índice.", "for ${i}, ${item} in enumerate(${itens}):\n    ${0}"],
     ["while", "while", "Laço com condição.", "while ${condicao}:\n    ${0}"],
     ["lc", "[x for x in ...]", "Compreensão de lista.", "[${x} for ${x} in ${itens}${ if x}]${0}"],
     ["dc", "{k: v for ...}", "Compreensão de dicionário.", "{${k}: ${v} for ${k}, ${v} in ${pares}}${0}"],
     ["gen", "(x for x in ...)", "Expressão geradora (não cria a lista toda).", "(${x} for ${x} in ${itens})${0}"],
     ["fstr", "f-string", "Texto com valores: f\"{nome=}\" mostra o nome e o valor.", "f\"${texto} {${valor}}\"${0}"],
     ["lambda", "lambda", "Função anônima curta.", "lambda ${x}: ${0}"],
     ["prop", "@property", "Atributo calculado.", "@property\ndef ${nome}(self) -> ${tipo}:\n    return ${0}"],
     ["cm", "@contextmanager", "Gerenciador de contexto com yield.", "from contextlib import contextmanager\n\n\n@contextmanager\ndef ${nome}():\n    ${preparar}\n    try:\n        yield ${0}\n    finally:\n        ${limpar}"],
     ["async", "async def", "Função assíncrona.", "async def ${nome}(${args}) -> ${None}:\n    ${0}"],
     ["gather", "asyncio.gather", "Roda corrotinas em paralelo.", "resultados = await asyncio.gather(${tarefa1}, ${tarefa2})${0}"],
     ["match", "match/case", "Casamento de padrões (3.10+).", "match ${valor}:\n    case ${padrao}:\n        ${0}\n    case _:\n        pass"],
     ["exc", "exceção própria", "Classe de erro do domínio.", "class ${Nome}Error(Exception):\n    \"\"\"${descricao}\"\"\"\n${0}"],
     ["enum", "Enum", "Constantes nomeadas.", "from enum import Enum\n\n\nclass ${Nome}(str, Enum):\n    ${A} = \"${a}\"\n    ${0}"],
     ["log", "logging", "Logger do módulo.", "import logging\n\nlog = logging.getLogger(__name__)\n${0}"],
     ["argparse", "CLI com argparse", "Linha de comando com argumentos.", "import argparse\n\n\ndef main() -> None:\n    p = argparse.ArgumentParser(description=\"${descricao}\")\n    p.add_argument(\"${--nome}\", default=${None})\n    args = p.parse_args()\n    ${0}\n\n\nif __name__ == \"__main__\":\n    main()"],
     ["jsonr", "ler JSON", "Lê um arquivo JSON.", "import json\nfrom pathlib import Path\n\ndados = json.loads(Path(${arquivo}).read_text(encoding=\"utf-8\"))${0}"],
     ["repr", "__repr__", "Representação para depuração.", "def __repr__(self) -> str:\n    return f\"${Nome}(${0})\""],
     ["walrus", ":=", "Atribui e usa na mesma expressão.", "if (${n} := ${expressao}):\n    ${0}"],
     ["protocol", "Protocol", "Interface por estrutura (duck typing com tipos).", "from typing import Protocol\n\n\nclass ${Nome}(Protocol):\n    def ${metodo}(self) -> ${None}: ...\n${0}"]]}
   ]},
