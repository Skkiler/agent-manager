# Somente valores sintéticos / parâmetros públicos. Nunca commitar .env real.
APP_ENV=development
APP_BIND_HOST=127.0.0.1
APP_PORT=8787
APP_LOG_LEVEL=INFO
APP_DATA_DIR=./data
APP_LOG_DIR=./logs
APP_SESSION_TTL_MINUTES=60
APP_ENABLE_LOCAL_LLM=false
APP_RESOURCE_PROFILE=auto
APP_RESERVE_FREE_RAM_GB=4
APP_MAX_ACTIVE_LLM_SESSIONS=1
APP_MAX_PARALLEL_CPU_TOOLS=2
APP_KIRO_ACP_ENABLED=false
APP_REQUIRE_AUTH=true
APP_ALLOW_LAN_BIND=false
# Configure segredos reais por OS keyring/secret store local, não por arquivo versionado.

# --- Kiro ACP (Fase 2). Desligado por padrao. A autenticacao e do proprio kiro-cli (kiro-cli login); nada aqui e segredo.
# APP_KIRO_ACP_ENABLED=true usa o Kiro REAL (consome creditos da conta logada).
# APP_KIRO_CLI_PATH=            # vazio = procurar kiro-cli no PATH e em %LOCALAPPDATA%\Kiro-Cli
# APP_KIRO_WORKSPACE=           # vazio = ./data/kiro-workspace (diretorio VAZIO e isolado; nao aponte para o repositorio)
# APP_KIRO_AGENT=
# APP_KIRO_MODEL=
APP_KIRO_PROMPT_TIMEOUT_SECONDS=300

# --- Memoria / segundo cerebro (Fase 3). O conteudo da memoria vive em data/ (ignorado pelo Git); nunca o versione.
# Namespaces que esta instancia pode ler/escrever. 'empresa/<id>' e 'terceiros' exigem inclusao explicita.
APP_MEMORY_ALLOWED_NAMESPACES=publico,pessoal
# Raizes de disco autorizadas para ingestao via API, separadas por ';'. Vazio = ingestao via API DESLIGADA.
# APP_MEMORY_INGEST_ROOTS=C:\caminho\do\repositorio-publico
# --- Contexto automatico no prompt (Fase 4). Somente estes namespaces podem ir ao provedor; subconjunto de APP_MEMORY_ALLOWED_NAMESPACES.
APP_CONTEXT_ENABLED=true
APP_CONTEXT_NAMESPACES=publico
APP_CONTEXT_BUDGET_TOKENS=2000
# --- Ferramentas dos agentes (Fase 4). Pastas que as ferramentas de arquivo podem ler, separadas por ';'. Vazio = desligadas.
# APP_TOOLS_ROOTS=C:\caminho\do\repositorio-publico
